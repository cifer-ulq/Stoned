# Dependencies
node_modules/
vendor/
hireme-api/vendor/
hireme-api/node_modules/

# Production builds
dist/
build/
hireme-api/public/build/
hireme-api/public/hot/
hireme-api/public/storage/

# Environment files and credentials (PROTECT SECRETS)
.env
.env.*
!.env.example
auth.json

# Logs and databases
*.log
storage/*.key
