hireme-api/storage/framework/sessions/*
hireme-api/storage/framework/views/*
!hireme-api/storage/framework/cache/.gitignore
!hireme-api/storage/framework/sessions/.gitignore
!hireme-api/storage/framework/views/.gitignore

# Cache and testing
.phpunit.result.cache
.phpunit.cache/
.phpactor.json
