/* ── Page-Specific Styles — Admin Portal ── */

/* ── Page Header ── */
.page-header { padding: var(--space-4) 0 var(--space-5); }
.page-header__title { font-size: var(--text-2xl); font-weight: var(--weight-bold); display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-1); }
.page-header__subtitle { font-size: var(--text-sm); color: var(--text-secondary); }

/* ── Stats Grid ── */
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-6); }
.stats-grid--6 { grid-template-columns: repeat(3, 1fr); }

/* ── Dashboard 2-column ── */
.dash-panels { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-6); }

/* ── Toolbar ── */
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); flex-wrap: wrap; }
.toolbar__left { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.toolbar__right { display: flex; align-items: center; gap: var(--space-3); }

/* ── Activity Feed ── */
.activity-item { display: flex; gap: var(--space-3); padding: var(--space-3) 0; }
.activity-item:not(:last-child) { border-bottom: 1px solid var(--border-default); }
.activity-item__icon {
  width: 32px; height: 32px; border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.activity-item__icon svg { width: 14px; height: 14px; }
.activity-item__content { flex: 1; }
.activity-item__text { font-size: var(--text-xs); color: var(--text-primary); line-height: 1.4; }
.activity-item__time { font-size: 0.65rem; color: var(--text-tertiary); margin-top: 2px; }

/* ── Approval Queue ── */
.approval-item {
  display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0;
  border-bottom: 1px solid var(--border-default);
}
.approval-item:last-child { border-bottom: 0; }
.approval-item__icon {
  width: 36px; height: 36px; border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.approval-item__info { flex: 1; min-width: 0; }
.approval-item__name { font-size: var(--text-sm); font-weight: var(--weight-medium); }
.approval-item__detail { font-size: var(--text-xs); color: var(--text-tertiary); }
.approval-item__actions { display: flex; gap: var(--space-2); }

/* ── Student/Company List Card ── */
.entity-card {
  display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5);
  background: var(--bg-elevated); border: 1px solid var(--border-default);
  border-radius: var(--radius-xl); transition: all var(--duration-fast);
}
.entity-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-primary-bg-strong); }
.entity-card__header { display: flex; align-items: center; gap: var(--space-3); }
.entity-card__avatar {
  width: 44px; height: 44px; border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: var(--text-sm); font-weight: var(--weight-bold); flex-shrink: 0;
}
.entity-card__info { flex: 1; min-width: 0; }
.entity-card__name { font-size: var(--text-sm); font-weight: var(--weight-semibold); margin: 0; }
.entity-card__sub { font-size: var(--text-xs); color: var(--text-secondary); margin: 0; }
.entity-card__meta { display: flex; flex-wrap: wrap; gap: var(--space-3); font-size: var(--text-xs); color: var(--text-tertiary); }
.entity-card__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--border-default); }

.entity-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: var(--space-4); }

/* ── Section Grid ── */
.section-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }

/* ── Slider / Weight Config ── */
.weight-row { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--border-default); }
.weight-row:last-child { border-bottom: 0; }
.weight-row__label { font-size: var(--text-sm); flex: 1; }
.weight-row__slider { flex: 2; }
.weight-row__value { font-size: var(--text-sm); font-weight: var(--weight-semibold); width: 50px; text-align: right; }
input[type="range"] {
  width: 100%; height: 6px; border-radius: var(--radius-full); background: var(--bg-tertiary);
  appearance: none; outline: none; cursor: pointer;
}
input[type="range"]::-webkit-slider-thumb {
  appearance: none; width: 18px; height: 18px; border-radius: 50%;
  background: var(--color-primary); cursor: pointer; border: 2px solid #fff; box-shadow: var(--shadow-sm);
}

/* ── Settings Grid ── */
.settings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-5); }
.settings-card {
  background: var(--bg-elevated); border: 1px solid var(--border-default);
  border-radius: var(--radius-xl); padding: var(--space-6); transition: all var(--duration-fast);
}
.settings-card:hover { box-shadow: var(--shadow-md); }
.settings-card__icon {
  width: 48px; height: 48px; border-radius: var(--radius-lg);
  display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);
}
.settings-card__title { font-size: var(--text-base); font-weight: var(--weight-semibold); margin-bottom: var(--space-2); }
.settings-card__desc { font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); margin-bottom: var(--space-4); }

/* ── Mini Chart Bar ── */
.mini-chart { display: flex; align-items: flex-end; gap: 3px; height: 60px; padding-top: var(--space-2); }
.mini-chart__bar {
  flex: 1; border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  background: var(--color-primary); opacity: 0.7; transition: opacity var(--duration-fast);
  min-width: 8px;
}
.mini-chart__bar:hover { opacity: 1; }

/* ── OJT Deployment Row ── */
.deploy-row {
  display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) 0;
  border-bottom: 1px solid var(--border-default);
}
.deploy-row:last-child { border-bottom: 0; }
.deploy-row__info { flex: 1; }
.deploy-row__name { font-size: var(--text-sm); font-weight: var(--weight-medium); }
.deploy-row__detail { font-size: var(--text-xs); color: var(--text-tertiary); }
.deploy-row__bar { width: 120px; }

/* ── Checklist ── */
.checklist-item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; font-size: var(--text-sm); }
.checklist-item__check {
  width: 20px; height: 20px; border-radius: var(--radius-sm); border: 2px solid var(--border-default);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.checklist-item__check--done { background: var(--color-success); border-color: var(--color-success); color: #fff; }

/* ── Report Card ── */
.report-card {
  background: var(--bg-elevated); border: 1px solid var(--border-default);
  border-radius: var(--radius-xl); padding: var(--space-6); transition: all var(--duration-fast); cursor: pointer;
}
.report-card:hover { border-color: var(--color-primary-bg-strong); box-shadow: var(--shadow-md); transform: translateY(-2px); }
.report-card__icon { width: 48px; height: 48px; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4); }
.report-card__title { font-size: var(--text-base); font-weight: var(--weight-semibold); margin-bottom: var(--space-2); }
.report-card__desc { font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); margin-bottom: var(--space-4); }
.report-card__footer { display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-4); border-top: 1px solid var(--border-default); }

.reports-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); }

/* ── Skill Tag ── */
.skill-tag {
  display: inline-flex; align-items: center; gap: var(--space-1);
  padding: var(--space-1) var(--space-3); font-size: var(--text-xs); font-weight: var(--weight-medium);
  background: var(--bg-tertiary); color: var(--text-primary); border-radius: var(--radius-full);
  border: 1px solid var(--border-default);
}
.skill-tag--primary { background: var(--color-primary-bg); color: var(--color-primary); border-color: transparent; }

/* ── Toggle Switch ── */
.toggle { display: flex; align-items: center; gap: var(--space-3); cursor: pointer; }
.toggle__track {
  width: 40px; height: 22px; border-radius: var(--radius-full); background: var(--bg-tertiary);
  position: relative; transition: background var(--duration-fast);
}
.toggle__track--on { background: var(--color-primary); }
.toggle__thumb {
  width: 18px; height: 18px; border-radius: 50%; background: #fff; position: absolute; top: 2px; left: 2px;
  transition: transform var(--duration-fast); box-shadow: var(--shadow-xs);
}
.toggle__track--on .toggle__thumb { transform: translateX(18px); }
.toggle__label { font-size: var(--text-sm); }
