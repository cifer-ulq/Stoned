{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hireme-api.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://hireme-api.onrender.com/storage/:path*"
    }
  ]
}
